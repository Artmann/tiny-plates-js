{
  "name": "tiny-plates",
  "version": "1.0.0",
  "description": "Clients for the Tiny Plates recipe API, with a plain Promise client, an Effect client and a command line tool.",
  "keywords": [
    "api-client",
    "cli",
    "cooking",
    "effect",
    "ingredients",
    "recipes",
    "tiny-plates"
  ],
  "homepage": "https://www.tinyplates.dev/docs",
  "bugs": {
    "url": "https://github.com/Artmann/tiny-plates-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artmann/tiny-plates-js.git"
  },
  "license": "MIT",
  "author": "Christoffer Artmann",
  "type": "module",
  "bin": {
    "tiny-plates": "./dist/cli.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect/index.d.ts",
        "default": "./dist/effect/index.js"
      },
      "require": {
        "types": "./dist/effect/index.d.cts",
        "default": "./dist/effect/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "cli": "bun src/cli/main.ts",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "generate": "bun scripts/generate.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@effect/openapi-generator": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@types/bun": "latest",
    "effect": "4.1.4",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "^7"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
